# Optional: enables the AI fallback that reads product pages when the
# structured-data parsers cannot find dimensions.
ANTHROPIC_API_KEY=

# Optional: enables "Make 3D" on custom items — generates a real 3D model
# from the item photo via Tripo (https://platform.tripo3d.ai). ~$0.40-0.50
# per generation. Without it the button is hidden and items render as
# correctly-sized boxes.
TRIPO_API_KEY=
